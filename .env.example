APP_NAME="Deacons School"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://deacons-school-system.onrender.com
FRONTEND_URL=https://deacons-school-frontend.vercel.app

CORS_ALLOWED_ORIGINS="https://deacons-school-frontend.vercel.app,http://localhost:3000,http://127.0.0.1:8000"

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Database Configuration (Render Postgres / External MySQL / SQLite)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=deacons_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=28800
SESSION_SAMESITE=Lax

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array

VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL=https://deacons-school-system.onrender.com
