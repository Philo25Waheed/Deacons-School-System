{
    "version": 2,
    "env": {
        "PHP_VERSION": "8.4",
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "APP_KEY": "base64:mdJSeoeHHmmRBRoz4/D8v+VStu9ZwlrzSw44ZFyijvU=",
        "LOG_CHANNEL": "stderr",
        "VIEW_COMPILED_PATH": "/tmp/views",
        "SESSION_DRIVER": "cookie",
        "CACHE_STORE": "array"
    },
    "build": {
        "env": {
            "PHP_VERSION": "8.4"
        }
    },
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/(css|js|assets|images|favicon.ico|robots.txt)(.*)",
            "dest": "/public/$1$2"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
